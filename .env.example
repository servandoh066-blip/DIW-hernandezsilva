# Copia este archivo como .env y rellena los valores.
# El archivo .env real NO se sube al repositorio.

# URL base de la API del backend (usada por las llamadas de axios)
API_URL="http://localhost:3000/api"

# Puerto en el que escucha el servidor Express
PORT=3000

# Cadena de conexión a MongoDB
MONGO_URI="mongodb://admin:abc123@localhost:27017/bbdd?authSource=admin"
